# Sao chép thành .env.local và điền giá trị. Chỉ dùng ở server — KHÔNG thêm tiền tố NEXT_PUBLIC_.
# AI_PROVIDER: gemini | openai | stub (stub chỉ dùng cho test/E2E)
AI_PROVIDER=gemini
AI_API_KEY=
# Alias luôn trỏ bản Gemini Flash mới nhất; ai-engineer (Hoàng Anh) có thể ghim bản cụ thể ở AI-03
AI_MODEL=gemini-flash-latest
AI_TIMEOUT_MS=15000
AI_TEMPERATURE=0.3
AI_RATE_LIMIT_PER_MIN=10
# Chỉ bật khi demo không có mạng / chạy E2E:
# ALLOW_STUB=1

# ── Tài khoản & database (docs/14). Thiếu 2 biến đầu → app chạy chế độ khách, không lỗi.
# Neon (Vercel → Storage → Neon tự set) · test/E2E: pglite://memory
DATABASE_URL=
# openssl rand -base64 32
BETTER_AUTH_SECRET=
# URL public khi deploy, VD https://vibecode-three-xi.vercel.app
BETTER_AUTH_URL=http://localhost:3000
# Tuỳ chọn — có thì hiện "Đăng nhập bằng Google"
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
