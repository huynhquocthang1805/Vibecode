# Sao chép thành .env.local và điền giá trị. Chỉ dùng ở server — KHÔNG thêm tiền tố NEXT_PUBLIC_.
# AI_PROVIDER: gemini | openai | stub (stub chỉ dùng cho test/E2E)
AI_PROVIDER=gemini
AI_API_KEY=
# Alias luôn trỏ bản Gemini Flash mới nhất; ai-engineer (Hoàng Anh) có thể ghim bản cụ thể ở AI-03
AI_MODEL=gemini-flash-latest
AI_TIMEOUT_MS=15000
AI_TEMPERATURE=0.3
AI_RATE_LIMIT_PER_MIN=10
# Chỉ bật khi demo không có mạng / chạy E2E:
# ALLOW_STUB=1

# ── Tài khoản & database (docs/14). Thiếu 2 biến đầu → app chạy chế độ khách, không lỗi.
# Neon (Vercel → Storage → Neon tự set) · test/E2E: pglite://memory
# `npm run build` tự áp migration drizzle/ khi có DATABASE_URL (scripts/db-migrate.mjs) — không cần chạy tay
DATABASE_URL=
# openssl rand -base64 32
BETTER_AUTH_SECRET=
# URL public khi deploy, VD https://vibecode-three-xi.vercel.app
BETTER_AUTH_URL=http://localhost:3000
# Tuỳ chọn — có thì hiện "Đăng nhập bằng Google"
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ── Xác nhận đăng ký bằng mã 6 số qua email (ACC-08). Thiếu SMTP_USER/SMTP_PASS → tắt, đăng ký vào thẳng như cũ.
# Gmail: SMTP_PASS là "Mật khẩu ứng dụng" 16 ký tự (Google Account → Bảo mật → Xác minh 2 bước → Mật khẩu ứng dụng),
# KHÔNG phải mật khẩu Gmail. Chỉ đặt ở server (Vercel → Environment Variables, bật Sensitive).
# SMTP_USER=quocthanghuynh180504@gmail.com
# SMTP_PASS=
# Tuỳ chọn: SMTP_HOST=smtp.gmail.com · SMTP_PORT=465 · EMAIL_FROM="KPI Mini <quocthanghuynh180504@gmail.com>"
