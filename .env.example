# Sao chép thành .env.local và điền giá trị. Chỉ dùng ở server — KHÔNG thêm tiền tố NEXT_PUBLIC_.
# AI_PROVIDER: gemini | openai | stub (stub chỉ dùng cho test)
AI_PROVIDER=gemini
AI_API_KEY=
# AI_MODEL: techlead chốt khi khởi tạo (VD bản Gemini Flash mới nhất)
AI_MODEL=
AI_TIMEOUT_MS=15000
AI_TEMPERATURE=0.3
AI_RATE_LIMIT_PER_MIN=10
# Chỉ bật khi demo không có mạng:
# ALLOW_STUB=1
